{
  "name": "extendable-markdown-preview",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "1.0.0",
  "icon": "icon.png",
  "publisher": "nesk",
  "license": "MIT",
  "aiKey": "0c6ae279ed8443289764825290e4f9e2-1a736e7c-1324-4338-be46-fc2a58ae4d14-7255",
  "engines": {
    "vscode": "^1.70.0"
  },
  "main": "./out/extension",
  "browser": "./dist/browser/extension",
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:markdown",
    "onLanguage:prompt",
    "onLanguage:instructions",
    "onLanguage:chatmode",
    "onCommand:markdown.api.render",
    "onCommand:markdown.api.reloadPlugins",
    "onWebviewPanel:markdown.preview"
  ],
  "capabilities": {
    "virtualWorkspaces": true,
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "%workspaceTrust%",
      "restrictedConfigurations": [
        "markdown.styles"
      ]
    }
  },
  "contributes": {
    "jsonValidation": [
      {
        "fileMatch": "package.json",
        "url": "./schemas/package.schema.json"
      }
    ],
    "nesk.markdown.previewStyles": [
      "./media/markdown.css",
      "./media/highlight.css"
    ],
    "nesk.markdown.previewScripts": [
      "./media/index.js"
    ],
    "customEditors": [
      {
        "viewType": "nesk.markdown.preview.editor",
        "displayName": "Extendable Markdown Preview",
        "priority": "option",
        "selector": [
          {
            "filenamePattern": "*.md"
          }
        ]
      }
    ]
  },
  "scripts": {
    "compile": "gulp compile-extension:markdown-language-features-languageService && gulp compile-extension:markdown-language-features && npm run build-preview && npm run build-notebook",
    "watch": "npm run build-preview && gulp watch-extension:markdown-language-features watch-extension:markdown-language-features-languageService",
    "vscode:prepublish": "npm run build-ext && npm run build-preview",
    "build-ext": "node ../../node_modules/gulp/bin/gulp.js --gulpfile ../../build/gulpfile.extensions.js compile-extension:markdown-language-features ./tsconfig.json",
    "build-notebook": "node ./esbuild-notebook.mjs",
    "build-preview": "node ./esbuild-preview.mjs",
    "compile-web": "npx webpack-cli --config extension-browser.webpack.config --mode none",
    "watch-web": "npx webpack-cli --config extension-browser.webpack.config --mode none --watch"
  },
  "dependencies": {
    "@vscode/extension-telemetry": "^0.9.8",
    "dompurify": "^3.2.4",
    "highlight.js": "^11.8.0",
    "markdown-it": "^12.3.2",
    "markdown-it-front-matter": "^0.2.4",
    "morphdom": "^2.7.4",
    "picomatch": "^2.3.1",
    "punycode": "^2.3.1",
    "vscode-languageclient": "^8.0.2",
    "vscode-languageserver-textdocument": "^1.0.11",
    "vscode-markdown-languageserver": "^0.5.0-alpha.12",
    "vscode-uri": "^3.0.3"
  },
  "devDependencies": {
    "@types/dompurify": "^3.0.5",
    "@types/lodash.throttle": "^4.1.3",
    "@types/markdown-it": "12.2.3",
    "@types/picomatch": "^2.3.0",
    "@types/vscode-notebook-renderer": "^1.60.0",
    "@types/vscode-webview": "^1.57.0",
    "@vscode/markdown-it-katex": "^1.1.1",
    "lodash.throttle": "^4.1.1",
    "vscode-languageserver-types": "^3.17.2",
    "vscode-markdown-languageservice": "^0.3.0-alpha.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/microsoft/vscode.git"
  }
}
